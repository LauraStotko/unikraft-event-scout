# ── Required ──────────────────────────────────────────────────────────────────

# Your Anthropic API key (claude-sonnet-4-5 is used for classification)
ANTHROPIC_API_KEY=sk-ant-...

# The ID of your Google Sheet (the long string in the URL between /d/ and /edit)
# e.g. https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id-here

# ── Google Auth — pick ONE of these two options ───────────────────────────────

# Option A: path to a service account JSON key file (local development)
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# Option B: the entire JSON key file as a single string (GitHub Actions secret)
# Paste the contents of your service account JSON here (no line breaks)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Optional ──────────────────────────────────────────────────────────────────

# Name of the tab in your Google Sheet (defaults to "Events")
SHEET_NAME=Events

# Slack incoming webhook URL for weekly summaries
# Create one at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Set to "true" to run the agent without writing anything to the sheet
DRY_RUN=false
